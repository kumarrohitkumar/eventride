NODE_ENV=development
PORT=3000

# timezone=UTC is REQUIRED: MySQL DATETIME has no offset, and every deadline depends on it.
# If 3306 is taken locally, run docker compose with MYSQL_PORT=3307 and use that port here.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/eventride?timezone=UTC"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET="dev-secret-change-me-in-production"
JWT_TTL="12h"

# mock = no API key, no billing account, works offline. Switch to google for live traffic.
ROUTING_PROVIDER=mock
# GOOGLE_MAPS_API_KEY=

CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Fixed OTP so reviewers can sign in as any seeded user. Refused when NODE_ENV=production.
DEV_OTP_ENABLED=true
DEV_OTP_CODE=000000
