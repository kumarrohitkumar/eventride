{
  "expo": {
    "name": "EventRide Guest",
    "slug": "eventride-guest",
    "scheme": "eventride-guest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "https://eventride-api-production.up.railway.app"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.eventride.guest"
    }
  }
}
